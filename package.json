{
  "name": "cache-action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub action that saves and restores the coursier, sbt and mill caches of Scala builds (Ammonite support is deprecated)",
  "scripts": {
    "build": "ncc build src/restore.ts --source-map --minify --out dist/restore && ncc build src/save.ts --source-map --minify --out dist/save",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src/**/*.ts",
    "test": "node --test \"__tests__/*.test.ts\"",
    "all": "npm run build && npm run typecheck && npm run format-check && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coursier/cache-action.git"
  },
  "homepage": "https://github.com/coursier/cache-action#readme",
  "bugs": {
    "url": "https://github.com/coursier/cache-action/issues"
  },
  "keywords": [
    "actions",
    "github-actions",
    "cache",
    "coursier",
    "sbt",
    "mill",
    "ammonite",
    "scala"
  ],
  "author": "Alexandre Archambault",
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.7.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
